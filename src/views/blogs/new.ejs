<%- include('../partials/header', { title: 'New Blog Post' }) %>
<%- include('../partials/sidebar', { activePage: 'blogs' }) %>

<!-- Include TinyMCE Script -->
<script src="https://cdn.jsdelivr.net/npm/tinymce@6.8.2/tinymce.min.js" referrerpolicy="origin"></script>

<main class="col-span-12 md:col-span-9 lg:col-span-10 space-y-6">
  <div class="flex items-center justify-between border-b border-slate-200/80 pb-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">New Blog Post</h1>
      <p class="text-sm text-slate-500 mt-1">Publish a new article using the document editor.</p>
    </div>
    <a href="/admin/blogs" class="text-xs font-bold text-slate-600 border border-slate-200 px-3 py-2 rounded-xl hover:bg-slate-100">Cancel</a>
  </div>

  <div class="bg-white border border-slate-200/80 rounded-2xl p-6 shadow-sm">
    <form action="/api/admin/blogs" method="POST" id="blogForm" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Article Title *</label>
          <input type="text" name="title" required placeholder="e.g. The Ultimate Guide to Sublimated Team Jerseys" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">URL Slug (Optional)</label>
          <input type="text" name="slug" placeholder="e.g. guide-to-sublimated-jerseys" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Author</label>
          <input type="text" name="author" value="ZarkoWear Admin" placeholder="ZarkoWear Admin" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Tags (comma separated)</label>
          <input type="text" name="tags" placeholder="uniforms, design tips, styling" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Cover Image URL *</label>
        <div class="flex gap-2">
          <input type="text" id="coverImage" name="coverImage" placeholder="Upload a file or paste image URL..." class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
          <button type="button" onclick="document.getElementById('fileInput').click()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
            <i class="bi bi-upload"></i> Upload Cover
          </button>
          <input type="file" id="fileInput" accept="image/*" class="hidden" />
        </div>
        <div id="uploadStatus" class="text-[10px] text-slate-450 mt-1 font-semibold hidden">Uploading...</div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Excerpt (Brief Teaser) *</label>
        <textarea name="excerpt" rows="2" required placeholder="Write a short 2-3 sentence summary for listing card previews..." class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
      </div>

      <!-- Rich Text Document Editor Container -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Content (Document Editor) *</label>
        <p class="text-[10px] text-slate-400 mb-2 font-medium">Use the toolbar to format headers, align text, insert lists, and embed layout images.</p>
        <textarea name="content" id="editor" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" style="min-height: 450px;">
          <h2>Add your heading here...</h2>
          <p>Write your paragraph content here. You can insert images, align them, and style the text using the toolbar above.</p>
        </textarea>
      </div>

      <div class="flex justify-end pt-2 gap-3">
        <a href="/admin/blogs" class="px-6 py-2.5 border border-slate-200 text-slate-650 hover:bg-slate-50 font-bold text-xs rounded-xl transition">Cancel</a>
        <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-md transition">Publish Article</button>
      </div>
    </form>
  </div>
</main>

<script>
  // Initialize TinyMCE Editor
  tinymce.init({
    selector: '#editor',
    plugins: 'image link lists media table code wordcount',
    toolbar: 'undo redo | blocks | bold italic underline | alignleft aligncenter alignright alignjustify | bullist numlist | link image media | code',
    height: 450,
    branding: false,
    promotion: false,
    content_style: 'body { font-family: Outfit, sans-serif; font-size: 14px; color: #334155; }',
    setup: function (editor) {
      editor.on('change', function () {
        tinymce.triggerSave();
      });
    }
  });

  // Handle Cover Image Upload
  document.getElementById('fileInput').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    
    const statusDiv = document.getElementById('uploadStatus');
    statusDiv.classList.remove('hidden');
    statusDiv.textContent = 'Uploading image to Cloudinary...';
    statusDiv.className = 'text-[10px] text-slate-400 mt-1 font-semibold';
    
    const formData = new FormData();
    formData.append('file', file);
    
    try {
      const res = await fetch('/api/admin/upload', { method: 'POST', body: formData });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Upload failed');
      document.getElementById('coverImage').value = data.url;
      statusDiv.textContent = 'Image uploaded successfully!';
      statusDiv.className = 'text-[10px] text-emerald-600 mt-1 font-semibold';
    } catch (err) {
      statusDiv.textContent = 'Upload failed: ' + err.message;
      statusDiv.className = 'text-[10px] text-rose-600 mt-1 font-semibold';
    }
  });

  // Handle Form Submission
  document.getElementById('blogForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Save TinyMCE content to textarea
    tinymce.triggerSave();
    
    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());
    
    // Split tags by comma
    body.tags = body.tags ? body.tags.split(',').map(t => t.trim()).filter(Boolean) : [];

    try {
      const res = await fetch(e.target.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.error || 'Failed to create blog post');
      }
      window.location.href = '/admin/blogs';
    } catch (err) {
      alert(err.message);
    }
  });
</script>

<%- include('../partials/footer') %>
