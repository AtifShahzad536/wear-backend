<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Builder Logos • WearConnect</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800">
  <div class="min-h-screen grid grid-cols-12">
    <!-- Sidebar -->
    <aside class="col-span-12 md:col-span-3 lg:col-span-2 bg-white border-r p-4 space-y-2">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-2 h-6 bg-indigo-600 rounded"></div>
        <h1 class="text-xl font-bold text-indigo-600">WearConnect Admin</h1>
      </div>
      <nav class="mt-4 space-y-1 text-sm">
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin">Dashboard</a>
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin/categories">Categories</a>
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin/uploads">Uploads</a>
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin/inquiries">Inquiries</a>
        
        <div class="mt-3 text-xs uppercase tracking-wide text-gray-400 px-3">Customizer</div>
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin/builder-models">Builder Models</a>
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin/builder-patterns">Builder Patterns</a>
        <a class="block px-3 py-2 rounded bg-indigo-50 text-indigo-700 font-medium" href="/admin/builder-logos">Builder Logos</a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="col-span-12 md:col-span-9 lg:col-span-10 p-6">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-semibold">Builder Logos Management</h2>
          <p class="text-sm text-gray-500">Configure logo decals for the 3D Customizer</p>
        </div>
        <a href="/admin/builder-logos/new" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-sm font-semibold transition flex items-center gap-1">
          Add New Logo
        </a>
      </div>

      <!-- Logos Table Card -->
      <div class="bg-white border rounded-2xl shadow-sm overflow-hidden">
        <div class="p-4 border-b bg-gray-50/50 flex items-center justify-between">
          <h3 class="font-semibold text-gray-800">Logos List</h3>
          <span class="text-xs font-bold text-gray-400"><%= (logos||[]).length %> total</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b bg-slate-50 text-xs font-bold uppercase text-slate-400">
                <th class="py-3.5 px-4 w-20">ID</th>
                <th class="py-3.5 px-4 w-24">Preview</th>
                <th class="py-3.5 px-4">Name</th>
                <th class="py-3.5 px-4">Category</th>
                <th class="py-3.5 px-4">Status</th>
                <th class="py-3.5 px-4">Created At</th>
                <th class="py-3.5 px-4 text-right pr-6">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if ((logos||[]).length === 0) { %>
                <tr>
                  <td colspan="7" class="py-8 text-center text-slate-400">No builder logos found.</td>
                </tr>
              <% } else { %>
                <% logos.forEach((l, idx) => { %>
                  <tr class="hover:bg-slate-50/50 transition duration-150">
                    <td class="py-4 px-4 font-mono text-xs text-slate-400">#<%= idx + 1 %></td>
                    <td class="py-4 px-4">
                      <div class="w-12 h-12 rounded-lg border bg-slate-50 flex items-center justify-center overflow-hidden p-1.5">
                        <% if (l.image_path) { %>
                          <img src="<%= l.image_path %>" alt="<%= l.name %>" class="max-w-full max-h-full object-contain" />
                        <% } else { %>
                          <span class="text-[9px] text-slate-300 font-bold uppercase">No image</span>
                        <% } %>
                      </div>
                    </td>
                    <td class="py-4 px-4 font-semibold text-slate-800"><%= l.name %></td>
                    <td class="py-4 px-4 text-slate-500 font-medium"><%= l.category || 'MISC. LOGOS' %></td>
                    <td class="py-4 px-4">
                      <span class="px-2.5 py-0.5 rounded-full text-xs font-bold <%= l.status ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-rose-50 text-rose-700 border border-rose-100' %>">
                        <%= l.status ? 'Active' : 'Inactive' %>
                      </span>
                    </td>
                    <td class="py-4 px-4 text-xs text-slate-400">
                      <%= new Date(l.createdAt || Date.now()).toLocaleString() %>
                    </td>
                    <td class="py-4 px-4 text-right pr-6">
                      <div class="inline-flex gap-2">
                        <a href="/admin/builder-logos/<%= l._id %>/edit" class="px-3 py-1 bg-white border border-slate-200 text-slate-600 rounded-lg text-xs font-bold uppercase hover:bg-slate-50 transition">
                          Edit
                        </a>
                        <form action="/api/admin/builder-logos/<%= l._id %>/delete" method="POST" onsubmit="return confirm('Delete logo <%= l.name %>?')">
                          <button type="submit" class="px-3 py-1 bg-white border border-rose-100 text-rose-600 rounded-lg text-xs font-bold uppercase hover:bg-rose-50 transition">
                            Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
