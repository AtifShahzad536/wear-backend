<%- include('../partials/header', { title: 'Blogs Manager' }) %>
<%- include('../partials/sidebar', { activePage: 'blogs' }) %>

<main class="col-span-12 md:col-span-9 lg:col-span-10 space-y-6">
  <!-- Page Title & Quick Actions -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">Blogs Management</h1>
      <p class="text-sm text-slate-500 mt-1">Publish and manage fashion blogs, styling guides, and sportswear trends.</p>
    </div>
    <a href="/admin/blogs/new" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-sm transition">
      <i class="bi bi-plus-lg"></i> New Blog Post
    </a>
  </div>

  <!-- Blogs Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm">
    <% if (!blogs || blogs.length === 0) { %>
      <div class="p-12 text-center text-slate-500 space-y-3">
        <i class="bi bi-journal-x text-4xl text-slate-300"></i>
        <p class="text-sm font-semibold">No blog posts found.</p>
        <p class="text-xs text-slate-400">Click "New Blog Post" to publish your first article.</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-250/60 text-[10px] font-extrabold uppercase tracking-wider text-slate-400">
              <th class="p-4 pl-6">Cover</th>
              <th class="p-4">Title / Excerpt</th>
              <th class="p-4">Author</th>
              <th class="p-4">Date</th>
              <th class="p-4 pr-6 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs font-semibold text-slate-700">
            <% blogs.forEach(blog => { %>
              <tr class="hover:bg-slate-50/50 transition">
                <td class="p-4 pl-6">
                  <div class="w-16 aspect-video rounded-lg overflow-hidden bg-slate-100 border border-slate-200/80 flex-shrink-0">
                    <% if (blog.coverImage) { %>
                      <img src="<%= blog.coverImage %>" alt="" class="w-full h-full object-cover" />
                    <% } else { %>
                      <div class="w-full h-full bg-slate-200 text-[8px] text-slate-400 font-bold flex items-center justify-center uppercase">No Image</div>
                    <% } %>
                  </div>
                </td>
                <td class="p-4 max-w-xs sm:max-w-md">
                  <div class="font-bold text-slate-900 text-sm truncate"><%= blog.title %></div>
                  <div class="text-[10px] text-slate-400 font-normal line-clamp-1 mt-0.5"><%= blog.excerpt %></div>
                </td>
                <td class="p-4 text-slate-500"><%= blog.author %></td>
                <td class="p-4 text-slate-400"><%= new Date(blog.createdAt).toLocaleDateString() %></td>
                <td class="p-4 pr-6 text-right space-x-2">
                  <a href="/admin/blogs/<%= blog._id %>/edit" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-600 transition" title="Edit">
                    <i class="bi bi-pencil-square"></i>
                  </a>
                  <button onclick="deleteBlog('<%= blog._id %>', '<%= blog.title %>')" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 transition" title="Delete">
                    <i class="bi bi-trash"></i>
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<script>
  async function deleteBlog(id, title) {
    if (!confirm('Are you sure you want to delete this blog post: "' + title + '"?')) return;
    try {
      const res = await fetch('/api/admin/blogs/' + id, {
        method: 'DELETE'
      });
      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.error || 'Failed to delete blog post');
      }
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
  }
</script>

<%- include('../partials/footer') %>
