<%- include('../partials/header', { title: 'Builder Logos' }) %>
<%- include('../partials/sidebar', { activePage: 'logos' }) %>

<main class="col-span-12 md:col-span-9 lg:col-span-10 space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">3D Builder Logos</h1>
      <p class="text-sm text-slate-500 mt-1">Configure vector logo decals for the 3D Customizer.</p>
    </div>
    <a href="/admin/builder-logos/new" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-sm transition">
      <i class="bi bi-plus-lg"></i> Add New Logo
    </a>
  </div>

  <div class="bg-white border border-slate-200/80 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex items-center justify-between">
      <h3 class="font-extrabold text-slate-900 text-sm">Logos List</h3>
      <span class="text-xs font-bold text-slate-400"><%= (logos||[]).length %> total</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-400 uppercase text-[10px] tracking-wider font-extrabold">
          <tr>
            <th class="py-3 px-4">Preview</th>
            <th class="py-3 px-4">Logo Name</th>
            <th class="py-3 px-4">Category</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4 text-right pr-6">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if ((logos||[]).length === 0) { %>
            <tr>
              <td colspan="5" class="py-8 text-center text-slate-400">No builder logos found.</td>
            </tr>
          <% } else { %>
            <% logos.forEach((l) => { %>
              <tr class="hover:bg-slate-50/50 transition">
                <td class="py-3 px-4">
                  <div class="w-12 h-12 rounded-xl border border-slate-200 bg-slate-50 flex items-center justify-center overflow-hidden p-1.5">
                    <% if (l.image_path) { %>
                      <img src="<%= l.image_path %>" alt="<%= l.name %>" class="w-full h-full object-contain" />
                    <% } else { %>
                      <span class="text-[9px] text-slate-300 font-bold uppercase">No image</span>
                    <% } %>
                  </div>
                </td>
                <td class="py-3 px-4 font-bold text-slate-800"><%= l.name %></td>
                <td class="py-3 px-4 text-slate-500 font-medium"><%= l.category || 'MISC. LOGOS' %></td>
                <td class="py-3 px-4">
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-bold <%= l.status ? 'bg-emerald-50 text-emerald-700 border border-emerald-100' : 'bg-rose-50 text-rose-700 border border-rose-100' %>">
                    <%= l.status ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td class="py-3 px-4 text-right pr-6">
                  <div class="inline-flex gap-2">
                    <a href="/admin/builder-logos/<%= l._id %>/edit" class="px-3 py-1 bg-white border border-slate-200 text-slate-700 rounded-xl text-xs font-bold hover:bg-slate-50 transition">
                      Edit
                    </a>
                    <form action="/api/admin/builder-logos/<%= l._id %>/delete" method="POST" onsubmit="return confirm('Delete logo <%= l.name %>?')">
                      <button type="submit" class="px-3 py-1 bg-white border border-rose-100 text-rose-600 rounded-xl text-xs font-bold hover:bg-rose-50 transition">
                        Delete
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
