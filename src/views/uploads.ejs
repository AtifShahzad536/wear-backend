<%- include('./partials/header', { title: 'Uploads' }) %>
<%- include('./partials/sidebar', { activePage: 'uploads' }) %>

<main class="col-span-12 md:col-span-9 lg:col-span-10 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">Uploads Media Library</h1>
      <p class="text-sm text-slate-500 mt-1">Browse, upload, and copy URLs of media assets.</p>
    </div>
    <button onclick="document.getElementById('uploadInput').click()" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-sm transition">
      <i class="bi bi-cloud-arrow-up-fill"></i> Upload Media
    </button>
    <input type="file" id="uploadInput" multiple accept="image/*" class="hidden" />
  </div>

  <div id="mediaGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
    <!-- Loaded dynamically -->
  </div>
</main>

<script>
  async function loadUploads() {
    try {
      const res = await fetch('/api/admin/uploads');
      const files = await res.json();
      const grid = document.getElementById('mediaGrid');
      grid.innerHTML = '';
      if (!files || files.length === 0) {
        grid.innerHTML = '<div class="col-span-full py-12 text-center text-slate-400 font-bold">No uploads found</div>';
        return;
      }
      files.forEach(f => {
        const html = `
          <div class="bg-white rounded-2xl border border-slate-200/80 p-2 shadow-sm flex flex-col justify-between group">
            <div class="h-28 bg-slate-50 rounded-xl overflow-hidden relative border border-slate-100">
              <img src="${f.url}" alt="${f.name}" class="w-full h-full object-cover group-hover:scale-105 transition" />
            </div>
            <div class="mt-2 space-y-1">
              <p class="text-[11px] font-bold text-slate-700 truncate" title="${f.name}">${f.name}</p>
              <button onclick="copyUrl('${f.url}')" class="w-full text-[10px] font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-100 py-1 rounded-lg transition">Copy URL</button>
            </div>
          </div>
        `;
        grid.insertAdjacentHTML('beforeend', html);
      });
    } catch (err) {
      console.error(err);
    }
  }

  function copyUrl(url) {
    navigator.clipboard.writeText(url);
    showToast('URL copied to clipboard!');
  }

  document.getElementById('uploadInput').addEventListener('change', async (e) => {
    const files = Array.from(e.target.files || []);
    if (!files.length) return;
    for (const f of files) {
      const form = new FormData();
      form.append('file', f);
      await fetch('/api/admin/upload', { method: 'POST', body: form });
    }
    showToast('Upload complete!');
    loadUploads();
  });

  loadUploads();
</script>

<%- include('./partials/footer') %>
