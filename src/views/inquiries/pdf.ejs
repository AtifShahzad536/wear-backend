<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Invoice — <%= inquiry.name %></title>
    <!-- Google Fonts: Outfit -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            font-family: 'Outfit', sans-serif;
            color: #1e293b;
            background-color: #ffffff;
            margin: 0;
            padding: 30px;
            font-size: 12.5px;
            line-height: 1.45;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .invoice-container { max-width: 950px; margin: 0 auto; }

        /* Header */
        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #f1f5f9;
            padding-bottom: 20px;
            margin-bottom: 25px;
        }

        .company-name {
            font-size: 22px;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 3px 0;
            letter-spacing: -0.5px;
        }

        .company-details {
            color: #64748b;
            font-size: 11px;
            line-height: 1.4;
        }

        .invoice-title {
            font-size: 24px;
            font-weight: 800;
            color: #4f46e5;
            margin: 0 0 5px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .meta-item { font-size: 11.5px; margin-bottom: 3px; color: #475569; }
        .meta-item strong { color: #0f172a; }

        /* Status Badge */
        .status-badge {
            display: inline-block;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 3px 9px;
            border-radius: 50px;
            margin-top: 4px;
            background-color: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
        }
        .status-pending    { background-color: #fef3c7; color: #d97706; border-color: #fde68a; }
        .status-processing { background-color: #dbeafe; color: #2563eb; border-color: #bfdbfe; }
        .status-quoted     { background-color: #ede9fe; color: #7c3aed; border-color: #ddd6fe; }
        .status-completed  { background-color: #dcfce7; color: #16a34a; border-color: #bbf7d0; }
        .status-cancelled  { background-color: #fee2e2; color: #dc2626; border-color: #fca5a5; }

        /* Info Section */
        .info-section { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 25px; }
        .info-col {
            flex: 1;
            background-color: #f8fafc;
            border-radius: 6px;
            padding: 12px 16px;
            border: 1px solid #f1f5f9;
        }
        .info-heading {
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #64748b;
            margin: 0 0 8px 0;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 4px;
        }
        .info-name { font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 4px; }
        .info-text { color: #475569; line-height: 1.4; font-size: 11.5px; }

        /* Design Preview */
        .design-preview-section {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 14px;
            margin-bottom: 25px;
            text-align: center;
        }
        .design-preview-title {
            font-size: 10px;
            font-weight: 800;
            color: #64748b;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-bottom: 10px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 4px;
        }
        .design-preview-section img {
            max-width: 100%;
            max-height: 320px;
            object-fit: contain;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
            background: white;
            padding: 8px;
        }

        /* Roster Table */
        .invoice-table { width: 100%; border-collapse: collapse; margin-bottom: 25px; }
        .invoice-table th {
            background-color: #0f172a;
            color: #ffffff;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 10.5px;
            letter-spacing: 0.5px;
            padding: 10px 14px;
            text-align: left;
        }
        .invoice-table th:first-child { border-top-left-radius: 4px; border-bottom-left-radius: 4px; }
        .invoice-table th:last-child { border-top-right-radius: 4px; border-bottom-right-radius: 4px; }
        .invoice-table td { padding: 10px 14px; border-bottom: 1px solid #e2e8f0; vertical-align: top; }
        .invoice-table tr:last-child td { border-bottom: 2px solid #cbd5e1; }

        /* Material Specs */
        .material-specs-box {
            background-color: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 25px;
            color: #1e3a8a;
        }
        .material-specs-title { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 6px; }
        .material-specs-list { margin: 0; padding-left: 20px; font-size: 11.5px; }
        .material-specs-list li { margin-bottom: 3px; }

        /* Admin note */
        .notes-box {
            background: #fffbeb;
            border: 1px dashed #fcd34d;
            border-radius: 6px;
            padding: 10px 14px;
            font-size: 11.5px;
            color: #78350f;
            margin-bottom: 20px;
        }

        /* Bottom totals */
        .bottom-section { display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; page-break-inside: avoid; }
        .totals-col {
            flex: 0.7;
            background-color: #f8fafc;
            border-radius: 6px;
            padding: 12px 16px;
            border: 1px solid #e2e8f0;
        }
        .total-row { display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 11.5px; color: #475569; }
        .total-row.grand-total {
            border-top: 2px solid #e2e8f0;
            padding-top: 8px;
            margin-top: 8px;
            font-size: 14.5px;
            font-weight: 800;
            color: #4f46e5;
        }

        /* WhatsApp info box */
        .whatsapp-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 6px;
            padding: 14px 18px;
            margin-bottom: 20px;
        }
        .whatsapp-box-title { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; color: #166534; margin-bottom: 6px; }
        .whatsapp-number { font-size: 18px; font-weight: 800; color: #16a34a; }

        /* Signature */
        .signature-section {
            margin-top: 50px;
            border-top: 1px solid #e2e8f0;
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            color: #64748b;
            font-size: 10.5px;
        }
        .signature-line { width: 180px; border-bottom: 1px solid #cbd5e1; margin-bottom: 4px; height: 35px; }

        /* No print button */
        .no-print-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            background: #4f46e5;
            color: white;
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 13px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .no-print-btn:hover { background: #4338ca; }
        .close-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            background: #f1f5f9;
            color: #64748b;
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 13px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            text-decoration: none;
            margin-bottom: 25px;
            margin-right: 8px;
        }

        @media print {
            body { padding: 15px; font-size: 11.5px; }
            .no-print { display: none !important; }
            @page { size: portrait; margin: 15mm; }
        }
    </style>
</head>
<body>
    <div class="invoice-container">

        <!-- Action Buttons (no print) -->
        <div class="no-print" style="margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
            <a href="/admin/inquiries/<%= inquiry._id %>" class="close-btn">
                <i class="bi bi-chevron-left"></i> Back
            </a>
            <button onclick="window.print()" class="no-print-btn">
                <i class="bi bi-printer-fill"></i> Print / Save as PDF
            </button>
        </div>

        <!-- Invoice Header -->
        <div class="invoice-header">
            <div style="display: flex; align-items: center; gap: 15px;">
                <div>
                    <h1 class="company-name">ZARKO SPORTSWEAR</h1>
                    <div class="company-details">
                        Custom 3D Jersey Inquiry — Production Sheet<br>
                        WhatsApp: +92 303 9200750
                    </div>
                </div>
            </div>

            <div style="text-align: right;">
                <h2 class="invoice-title">Order Inquiry</h2>
                <div class="meta-item">Order Ref: <strong>#ORD-<%= inquiry._id.toString().slice(-6).toUpperCase() %></strong></div>
                <div class="meta-item">Date Placed: <strong><%= new Date(inquiry.createdAt).toLocaleString('en-PK', { dateStyle: 'long', timeStyle: 'short' }) %></strong></div>
                <div>
                    <%
                      const s = (inquiry.status || 'Pending').toLowerCase().replace(' ', '-');
                      const statusMap = {
                        'pending': 'status-pending', 'in-review': 'status-processing',
                        'quoted': 'status-quoted', 'processing': 'status-processing',
                        'completed': 'status-completed', 'cancelled': 'status-cancelled'
                      };
                      const sc = statusMap[s] || '';
                    %>
                    <span class="status-badge <%= sc %>"><%= inquiry.status || 'Pending' %></span>
                </div>
            </div>
        </div>

        <!-- Info Columns -->
        <div class="info-section">
            <div class="info-col">
                <h3 class="info-heading">Customer / Bill To</h3>
                <div class="info-name"><%= inquiry.name %></div>
                <div class="info-text">
                    Email: <%= inquiry.email %><br>
                    <% if (inquiry.phone) { %>Phone: <%= inquiry.phone %><br><% } %>
                    <% if (inquiry.company) { %>Country: <%= inquiry.company %><% } %>
                </div>
            </div>
            <div class="info-col">
                <h3 class="info-heading">Order Type & Contact</h3>
                <div class="info-name">Custom 3D Jersey Design</div>
                <div class="info-text">
                    Inquiry Type: <%= inquiry.type === 'custom' ? '3D Customizer Order' : 'Contact Form' %><br>
                    Submitted via online customizer portal<br>
                    Pricing to be discussed via WhatsApp
                </div>
            </div>
        </div>

        <!-- WhatsApp Pricing Info Box -->
        <div class="whatsapp-box">
            <div class="whatsapp-box-title"><i class="bi bi-whatsapp me-1"></i> Pricing Information</div>
            <p style="font-size: 11.5px; color: #166534; margin: 0 0 6px;">
                Pricing for this custom order will be finalized via WhatsApp communication with the customer.
                Our team will review the design specifications and roster requirements before quoting.
            </p>
            <div class="whatsapp-number">+92 303 9200750</div>
        </div>

        <!-- Design Preview -->
        <% if (inquiry.fileUrl) { %>
        <div class="design-preview-section">
            <div class="design-picture-title design-preview-title">Custom 3D Design Preview — Submitted by Customer</div>
            <img src="<%= inquiry.fileUrl %>" alt="Custom Jersey Design Preview" />
        </div>
        <% } %>

        <!-- Roster / Message Details Table -->
        <%
          // Parse roster lines from message
          const rosterLines = [];
          const msgLines = (inquiry.message || '').split('\n');
          let inRoster = false;
          msgLines.forEach(line => {
            const trimmed = line.trim();
            if (trimmed.toLowerCase().startsWith('roster:')) { inRoster = true; return; }
            if (inRoster && trimmed.match(/^\d+\.\s/)) {
              rosterLines.push(trimmed);
            }
            if (inRoster && trimmed === '') inRoster = false;
          });
        %>
        <% if (rosterLines.length > 0) { %>
        <table class="invoice-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Player Name</th>
                    <th>Number</th>
                    <th>Size</th>
                </tr>
            </thead>
            <tbody>
                <% rosterLines.forEach(function(line, idx) {
                    const nameMatch = line.match(/Name:\s*"([^"]*)"/i);
                    const numMatch  = line.match(/Number:\s*"([^"]*)"/i);
                    const sizeMatch = line.match(/Size:\s*"([^"]*)"/i);
                %>
                <tr>
                    <td style="font-weight: 700; color: #0f172a;"><%= idx + 1 %></td>
                    <td style="font-weight: 600;"><%= nameMatch ? nameMatch[1] || '—' : '—' %></td>
                    <td><%= numMatch ? numMatch[1] || '—' : '—' %></td>
                    <td>
                      <span style="background:#f5f3ff;color:#4f46e5;border:1px solid #ddd6fe;font-size:10px;font-weight:700;padding:2px 8px;border-radius:50px;">
                        <%= sizeMatch ? sizeMatch[1] : '—' %>
                      </span>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
        <% } %>

        <!-- Full Order Message -->
        <div class="material-specs-box" style="page-break-inside: avoid;">
            <div class="material-specs-title"><i class="bi bi-file-text-fill me-1"></i> Full Order Message & Design Config</div>
            <pre style="white-space: pre-wrap; font-size: 11px; color: #1e3a8a; font-family: 'Outfit', monospace; margin: 0; max-height: 400px; overflow-y: auto;"><%= inquiry.message %></pre>
        </div>

        <!-- Admin note -->
        <% if (inquiry.admin_note) { %>
        <div class="notes-box">
            <strong style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px;">Admin Note (Internal):</strong><br>
            <span style="font-style: italic;"><%= inquiry.admin_note %></span>
        </div>
        <% } %>

        <!-- Bottom Section -->
        <div class="bottom-section">
            <div style="flex: 1.2;">
                <div style="font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; color: #64748b; margin-bottom: 6px;">Pricing Notes</div>
                <div style="background: #fafafa; border: 1px dashed #cbd5e1; border-radius: 4px; padding: 10px; color: #475569; font-size: 11.5px; line-height: 1.5;">
                    Pricing for this order will be discussed and confirmed with the customer via WhatsApp
                    before production begins. No payment has been collected at this stage.
                </div>
            </div>

            <div class="totals-col">
                <div class="total-row">
                    <span>Roster Size:</span>
                    <strong style="color: #0f172a;"><%= rosterLines.length || 'N/A' %> jerseys</strong>
                </div>
                <div class="total-row">
                    <span>Payment Method:</span>
                    <strong style="color: #0f172a;">WhatsApp Quoted</strong>
                </div>
                <div class="total-row">
                    <span>Status:</span>
                    <strong style="color: #4f46e5;"><%= inquiry.status || 'Pending' %></strong>
                </div>
                <div class="total-row grand-total">
                    <span>PRICE:</span>
                    <span>TBD via WhatsApp</span>
                </div>
            </div>
        </div>

        <!-- Signature Section -->
        <div class="signature-section">
            <div>
                <div class="signature-line"></div>
                <div>Customer Signature</div>
            </div>
            <div style="text-align: center;">
                <div style="font-size: 11px; font-weight: 700; color: #4f46e5; margin-bottom: 4px;">ZARKO SPORTSWEAR</div>
                <div style="font-size: 10px;">Custom 3D Jersey Production</div>
                <div style="font-size: 10px;">WhatsApp: +92 303 9200750</div>
            </div>
            <div style="text-align: right;">
                <div class="signature-line" style="margin-left: auto;"></div>
                <div>Authorized Signature</div>
            </div>
        </div>

        <!-- Footer -->
        <div style="margin-top: 30px; text-align: center; font-size: 10px; color: #94a3b8; border-top: 1px solid #f1f5f9; padding-top: 15px;">
            This is a production order sheet for internal use. Pricing TBD via WhatsApp communication.
            Generated on <%= new Date().toLocaleString('en-PK') %>.
        </div>
    </div>
</body>
</html>
