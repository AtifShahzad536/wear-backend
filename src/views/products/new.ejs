<%- include('../partials/header', { title: 'New Product' }) %>
<%- include('../partials/sidebar', { activePage: 'categories' }) %>

<main class="col-span-12 md:col-span-9 lg:col-span-10 space-y-6">
  <div class="flex items-center justify-between border-b border-slate-200/80 pb-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">Add Product to <%= category.name %></h1>
    </div>
    <a href="/admin/categories/<%= category.slug %>/products" class="text-xs font-bold text-slate-600 border border-slate-200 px-3 py-2 rounded-xl hover:bg-slate-100">Cancel</a>
  </div>

  <div class="bg-white border border-slate-200/80 rounded-2xl p-6 max-w-2xl shadow-sm">
    <form action="/api/admin/categories/<%= category.slug %>/products" method="POST" id="prodForm" class="space-y-5">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Product ID (Unique)</label>
        <input type="text" name="id" required placeholder="e.g. fb-kit-01" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Product Name</label>
        <input type="text" name="name" required placeholder="e.g. Pro Match Jersey" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Image URL / Upload</label>
        <div class="flex gap-2">
          <input type="text" id="image" name="image" placeholder="/uploads/file.jpg or https://..." class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
          <button type="button" onclick="document.getElementById('fileInput').click()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition">Upload File</button>
          <input type="file" id="fileInput" accept="image/*" class="hidden" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Description</label>
        <textarea name="description" rows="3" placeholder="Item description and details..." class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
      </div>

      <div class="flex justify-end pt-2">
        <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-md transition">Save Product</button>
      </div>
    </form>
  </div>
</main>

<script>
  document.getElementById('fileInput').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const formData = new FormData();
    formData.append('file', file);
    try {
      const res = await fetch('/api/admin/upload', { method: 'POST', body: formData });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Upload failed');
      document.getElementById('image').value = data.url;
      showToast('Image uploaded successfully!');
    } catch (err) {
      alert(err.message || 'Upload failed');
    }
  });

  document.getElementById('prodForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());
    try {
      const res = await fetch(e.target.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.error || 'Failed to create product');
      }
      window.location.href = '/admin/categories/<%= category.slug %>/products';
    } catch (err) {
      alert(err.message);
    }
  });
</script>

<%- include('../partials/footer') %>
