<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Builder Logo • WearConnect</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800">
  <div class="min-h-screen grid grid-cols-12">
    <!-- Sidebar -->
    <aside class="col-span-12 md:col-span-3 lg:col-span-2 bg-white border-r p-4 space-y-2">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-2 h-6 bg-indigo-600 rounded"></div>
        <h1 class="text-xl font-bold text-indigo-600">WearConnect Admin</h1>
      </div>
      <nav class="mt-4 space-y-1 text-sm">
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin">Dashboard</a>
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin/categories">Categories</a>
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin/uploads">Uploads</a>
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin/inquiries">Inquiries</a>
        
        <div class="mt-3 text-xs uppercase tracking-wide text-gray-400 px-3">Customizer</div>
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin/builder-models">Builder Models</a>
        <a class="block px-3 py-2 rounded hover:bg-gray-100" href="/admin/builder-patterns">Builder Patterns</a>
        <a class="block px-3 py-2 rounded bg-indigo-50 text-indigo-700 font-medium" href="/admin/builder-logos">Builder Logos</a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="col-span-12 md:col-span-9 lg:col-span-10 p-6">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-semibold">New Builder Logo</h2>
        <a href="/admin/builder-logos" class="px-4 py-2 border rounded hover:bg-gray-50 text-sm">Back</a>
      </div>

      <div class="bg-white border rounded-2xl p-6 max-w-xl shadow-sm">
        <form action="/api/admin/builder-logos" method="POST" class="space-y-6">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Logo Name</label>
            <input type="text" name="name" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g. Nike Swoosh" required />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Category (e.g. BRANDS, SHIELD, MISC. LOGOS)</label>
            <input type="text" name="category" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g. BRANDS" required />
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Logo Image Path</label>
            <div class="flex gap-2">
              <input type="text" id="image_path" name="image_path" class="flex-1 rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="e.g. /uploads/nike.png" required />
              <button type="button" onclick="triggerUpload('image_path', 'image/*')" class="px-4 py-3 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-xl text-xs font-bold uppercase transition">Upload</button>
            </div>
            <p class="text-xs text-gray-400 mt-1">Prefer transparent SVG or high-res PNG logo files.</p>
          </div>

          <div class="flex items-center gap-2">
            <input type="checkbox" name="status" id="status" value="true" checked class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" />
            <label for="status" class="text-sm text-gray-700 font-medium">Active (visible in Customizer)</label>
          </div>

          <div class="flex justify-end">
            <button type="submit" class="px-6 py-3 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 shadow-md hover:-translate-y-0.5 transition">Save Logo</button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <input type="file" id="hiddenFileInput" class="hidden" />

  <script>
    let activeFieldId = '';

    function triggerUpload(fieldId, acceptTypes) {
      activeFieldId = fieldId;
      const fileInput = document.getElementById('hiddenFileInput');
      fileInput.accept = acceptTypes;
      fileInput.value = '';
      fileInput.click();
    }

    document.getElementById('hiddenFileInput').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file || !activeFieldId) return;

      const formData = new FormData();
      formData.append('file', file);

      const btn = document.querySelector(`button[onclick*="${activeFieldId}"]`);
      const originalText = btn.textContent;
      btn.textContent = 'Uploading...';
      btn.disabled = true;

      try {
        const res = await fetch('/api/admin/upload', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed');

        document.getElementById(activeFieldId).value = data.url;
      } catch (err) {
        alert(err.message || 'File upload failed');
      } finally {
        btn.textContent = originalText;
        btn.disabled = false;
      }
    });
  </script>
</body>
</html>
