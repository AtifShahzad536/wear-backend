<%- include('partials/header', { title: 'Admin Dashboard' }) %>
<%- include('partials/sidebar', { activePage: 'dashboard' }) %>

    <!-- Main -->
    <main class="col-span-12 md:col-span-9 lg:col-span-10 p-6 space-y-6">
      <!-- Header -->
      <div class="rounded-2xl p-6 bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow mb-6 overflow-hidden">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-2xl md:text-3xl font-semibold">Welcome back</h2>
            <p class="text-white/80 text-sm">Manage categories, products, media and homepage content</p>
          </div>
          <a href="/admin/categories/new" class="px-4 py-2 bg-white/20 hover:bg-white/30 rounded-md text-white text-sm transition">+ New Category</a>
        </div>
        <div class="mt-4 grid grid-cols-2 md:grid-cols-4 gap-3">
          <a href="/admin/home/hero" class="group rounded-xl bg-white/10 backdrop-blur p-4 hover:bg-white/15 transition flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center">🏞️</div>
            <div class="text-sm">Hero Images</div>
          </a>
          <a href="/admin/home/testimonials" class="group rounded-xl bg-white/10 backdrop-blur p-4 hover:bg-white/15 transition flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center">💬</div>
            <div class="text-sm">Testimonials</div>
          </a>
          <a href="/admin/home/top-selling" class="group rounded-xl bg-white/10 backdrop-blur p-4 hover:bg-white/15 transition flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center">⭐</div>
            <div class="text-sm">Top Selling</div>
          </a>
          <a href="/admin/uploads" class="group rounded-xl bg-white/10 backdrop-blur p-4 hover:bg-white/15 transition flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center">📁</div>
            <div class="text-sm">Uploads</div>
          </a>
        </div>
      </div>

      <!-- Stat Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="group rounded-xl p-5 bg-white shadow-sm border hover:shadow-md transition">
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-500">Categories</div>
            <div class="w-8 h-8 rounded-md bg-indigo-50 text-indigo-600 flex items-center justify-center">📦</div>
          </div>
          <div class="mt-2 text-3xl font-bold text-indigo-700 group-hover:translate-x-0.5 transition"><%= (stats && stats.categories) || 0 %></div>
        </div>
        <div class="group rounded-xl p-5 bg-white shadow-sm border hover:shadow-md transition">
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-500">Products</div>
            <div class="w-8 h-8 rounded-md bg-emerald-50 text-emerald-600 flex items-center justify-center">🛍️</div>
          </div>
          <div class="mt-2 text-3xl font-bold text-emerald-700 group-hover:translate-x-0.5 transition"><%= (stats && stats.products) || 0 %></div>
        </div>
        <div class="group rounded-xl p-5 bg-white shadow-sm border hover:shadow-md transition">
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-500">Uploads</div>
            <div class="w-8 h-8 rounded-md bg-rose-50 text-rose-600 flex items-center justify-center">⬆️</div>
          </div>
          <div class="mt-2 text-3xl font-bold text-rose-700 group-hover:translate-x-0.5 transition">—</div>
        </div>
      </div>

      <!-- Recent Products -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-lg font-semibold">Recent Products</h3>
          <a class="text-sm text-indigo-700 hover:underline" href="/admin/categories">View all</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <% (recentProducts || []).forEach(p => { %>
            <div class="bg-white rounded-xl border shadow-sm hover:shadow-md hover:-translate-y-0.5 transition overflow-hidden">
              <div class="h-28 bg-gray-100 flex items-center justify-center text-gray-400 text-sm">
                <% 
                  let img = (p.image || '').replace(/\\/g,'/');
                  if (img && img[0] !== '/') img = '/' + img;
                  if (img.startsWith('/images/')) img = img.replace('/images/', '/uploads/');
                %>
                <% if (img) { %>
                  <img src="<%= img %>" alt="<%= p.name %>" class="max-h-28 object-contain transition group-hover:scale-[1.02]" />
                <% } else { %>
                  <span>No Image</span>
                <% } %>
              </div>
              <div class="p-4">
                <div class="text-xs px-2 py-0.5 rounded-full bg-gray-100 w-fit text-gray-600 mb-2"><%= p.categoryName %></div>
                <div class="font-semibold"><%= p.name %></div>
                <div class="mt-3 flex items-center justify-between text-sm">
                  <a class="px-3 py-1 border rounded hover:bg-gray-50" href="/admin/categories/<%= p.category %>/products">Manage</a>
                  <a class="px-3 py-1 border rounded hover:bg-gray-50" href="/admin/categories/<%= p.category %>/products/<%= p.id %>/edit">Edit</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="/admin/categories" class="group rounded-xl p-5 bg-white shadow-sm border hover:shadow-md transition flex items-center justify-between">
          <div>
            <div class="text-sm text-gray-500">Manage</div>
            <div class="text-lg font-semibold">Categories</div>
          </div>
          <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center group-hover:scale-105 transition">C</div>
        </a>
        <a href="/admin/uploads" class="group rounded-xl p-5 bg-white shadow-sm border hover:shadow-md transition flex items-center justify-between">
          <div>
            <div class="text-sm text-gray-500">Media</div>
            <div class="text-lg font-semibold">Uploads</div>
          </div>
          <div class="w-8 h-8 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center group-hover:scale-105 transition">U</div>
        </a>
        <a href="/admin/categories/new" class="group rounded-xl p-5 bg-white shadow-sm border hover:shadow-md transition flex items-center justify-between">
          <div>
            <div class="text-sm text-gray-500">Create</div>
            <div class="text-lg font-semibold">New Category</div>
          </div>
          <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center group-hover:scale-105 transition">+</div>
        </a>
      </div>
    </main>
<%- include('partials/footer') %>
