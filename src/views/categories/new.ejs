<%- include('../partials/header', { title: 'New Category' }) %>
<%- include('../partials/sidebar', { activePage: 'categories' }) %>

<main class="col-span-12 md:col-span-9 lg:col-span-10 space-y-6">
  <div class="flex items-center justify-between border-b border-slate-200/80 pb-4">
    <h1 class="text-2xl font-extrabold text-slate-900">New Category</h1>
    <a href="/admin/categories" class="text-xs font-bold text-slate-600 border border-slate-200 px-3 py-2 rounded-xl hover:bg-slate-100">Cancel</a>
  </div>

  <div class="bg-white border border-slate-200/80 rounded-2xl p-6 max-w-xl shadow-sm">
    <form action="/api/admin/categories" method="POST" id="catForm" class="space-y-5">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Category Slug (lowercase)</label>
        <input type="text" name="slug" required placeholder="e.g. football, wrestling" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Category Display Name</label>
        <input type="text" name="name" required placeholder="e.g. Football Kits" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
      </div>

      <div class="flex justify-end pt-2">
        <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-md transition">Save Category</button>
      </div>
    </form>
  </div>
</main>

<script>
  document.getElementById('catForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());
    try {
      const res = await fetch(e.target.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.error || 'Failed to create category');
      }
      window.location.href = '/admin/categories';
    } catch (err) {
      alert(err.message);
    }
  });
</script>

<%- include('../partials/footer') %>
