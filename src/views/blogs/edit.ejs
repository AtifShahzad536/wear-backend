<%- include('../partials/header', { title: 'Edit Blog Post' }) %>
<%- include('../partials/sidebar', { activePage: 'blogs' }) %>

<main class="col-span-12 md:col-span-9 lg:col-span-10 space-y-6">
  <div class="flex items-center justify-between border-b border-slate-200/80 pb-4">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">Edit Blog Post</h1>
      <p class="text-sm text-slate-500 mt-1">Make changes to your published article.</p>
    </div>
    <a href="/admin/blogs" class="text-xs font-bold text-slate-600 border border-slate-200 px-3 py-2 rounded-xl hover:bg-slate-100">Cancel</a>
  </div>

  <div class="bg-white border border-slate-200/80 rounded-2xl p-6 shadow-sm">
    <form action="/api/admin/blogs/<%= blog._id %>" method="POST" id="blogForm" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Article Title *</label>
          <input type="text" name="title" required value="<%= blog.title %>" placeholder="e.g. The Ultimate Guide to Sublimated Team Jerseys" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">URL Slug (Optional)</label>
          <input type="text" name="slug" value="<%= blog.slug %>" placeholder="e.g. guide-to-sublimated-jerseys" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Author</label>
          <input type="text" name="author" value="<%= blog.author %>" placeholder="ZarkoWear Admin" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Tags (comma separated)</label>
          <input type="text" name="tags" value="<%= blog.tags ? blog.tags.join(', ') : '' %>" placeholder="uniforms, design tips, styling" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Cover Image URL *</label>
        <div class="flex gap-2">
          <input type="text" id="coverImage" name="coverImage" value="<%= blog.coverImage %>" placeholder="Upload a file or paste image URL..." class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
          <button type="button" onclick="document.getElementById('fileInput').click()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
            <i class="bi bi-upload"></i> Upload Cover
          </button>
          <input type="file" id="fileInput" accept="image/*" class="hidden" />
        </div>
        <div id="uploadStatus" class="text-[10px] text-slate-450 mt-1 font-semibold <%= blog.coverImage ? 'text-emerald-600' : 'hidden' %>">
          <%= blog.coverImage ? 'Image already uploaded' : 'Uploading...' %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Excerpt (Brief Teaser) *</label>
        <textarea name="excerpt" rows="2" required placeholder="Write a short 2-3 sentence summary for listing card previews..." class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"><%= blog.excerpt %></textarea>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Content (HTML Supported) *</label>
        <p class="text-[10px] text-slate-400 mb-2 font-medium">Tip: HTML tags like &lt;h2&gt;, &lt;p&gt;, &lt;strong&gt;, &lt;ul&gt;, &lt;li&gt;, and links can be used to format the article beautifully.</p>
        <textarea name="content" rows="12" required placeholder="Write the full body content of your blog post here..." class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none font-mono"><%= blog.content %></textarea>
      </div>

      <div class="flex justify-end pt-2 gap-3">
        <a href="/admin/blogs" class="px-6 py-2.5 border border-slate-200 text-slate-650 hover:bg-slate-50 font-bold text-xs rounded-xl transition">Cancel</a>
        <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-md transition">Save Changes</button>
      </div>
    </form>
  </div>
</main>

<script>
  // Handle Cover Image Upload
  document.getElementById('fileInput').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    
    const statusDiv = document.getElementById('uploadStatus');
    statusDiv.classList.remove('hidden');
    statusDiv.textContent = 'Uploading image to Cloudinary...';
    statusDiv.className = 'text-[10px] text-slate-400 mt-1 font-semibold';
    
    const formData = new FormData();
    formData.append('file', file);
    
    try {
      const res = await fetch('/api/admin/upload', { method: 'POST', body: formData });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Upload failed');
      document.getElementById('coverImage').value = data.url;
      statusDiv.textContent = 'Image uploaded successfully!';
      statusDiv.className = 'text-[10px] text-emerald-600 mt-1 font-semibold';
    } catch (err) {
      statusDiv.textContent = 'Upload failed: ' + err.message;
      statusDiv.className = 'text-[10px] text-rose-600 mt-1 font-semibold';
    }
  });

  // Handle Form Submission
  document.getElementById('blogForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());
    
    // Split tags by comma
    body.tags = body.tags ? body.tags.split(',').map(t => t.trim()).filter(Boolean) : [];

    try {
      const res = await fetch(e.target.action, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.error || 'Failed to update blog post');
      }
      window.location.href = '/admin/blogs';
    } catch (err) {
      alert(err.message);
    }
  });
</script>

<%- include('../partials/footer') %>
