<%- include('partials/header', { title: 'Dashboard' }) %>
<%- include('partials/sidebar', { activePage: 'dashboard' }) %>

<main class="col-span-12 md:col-span-9 lg:col-span-10 space-y-6">
  <!-- Top Welcome Banner -->
  <div class="bg-gradient-to-r from-indigo-900 via-indigo-800 to-indigo-600 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="space-y-2 relative z-10">
      <span class="px-3 py-1 bg-white/15 backdrop-blur-md rounded-full text-xs font-bold uppercase tracking-wider text-indigo-200">Zarko Analytics</span>
      <h1 class="text-2xl sm:text-3xl font-extrabold">Welcome back, Admin 👋</h1>
      <p class="text-indigo-200 text-sm max-w-xl">Live store metrics, kit orders, category performance, and 3D customizer activity.</p>
    </div>
    <div class="flex items-center gap-3 relative z-10">
      <a href="/admin/categories" class="px-4 py-2.5 bg-white text-indigo-950 font-bold text-xs rounded-xl shadow-lg hover:bg-indigo-50 transition">
        Manage Catalog
      </a>
      <a href="/admin/inquiries" class="px-4 py-2.5 bg-indigo-700/80 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl border border-indigo-500/30 transition">
        View Orders
      </a>
    </div>
  </div>

  <!-- Metric Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">Total Categories</p>
        <p class="text-3xl font-extrabold text-slate-900 mt-1"><%= stats?.categories || 0 %></p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold">
        <i class="bi bi-box-seam"></i>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">Total Products</p>
        <p class="text-3xl font-extrabold text-slate-900 mt-1"><%= stats?.products || 0 %></p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
        <i class="bi bi-tag-fill"></i>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">Inquiries & Orders</p>
        <p class="text-3xl font-extrabold text-slate-900 mt-1"><%= stats?.inquiries || 0 %></p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
        <i class="bi bi-chat-left-text-fill"></i>
      </div>
    </div>

    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center justify-between">
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400">3D Builder Models</p>
        <p class="text-3xl font-extrabold text-slate-900 mt-1"><%= stats?.models || 0 %></p>
      </div>
      <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl font-bold">
        <i class="bi bi-bounding-box-circles"></i>
      </div>
    </div>
  </div>

  <!-- Interactive Charts Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Bar / Line Chart -->
    <div class="lg:col-span-7 bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-extrabold text-slate-900 text-base">Inquiries & Orders Trend</h2>
          <p class="text-xs text-slate-400">Monthly customer quotes & 3D kit requests overview</p>
        </div>
        <span class="text-xs font-bold text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full">2026 Analytics</span>
      </div>
      <div class="h-64">
        <canvas id="ordersChart"></canvas>
      </div>
    </div>

    <!-- Doughnut / Pie Chart -->
    <div class="lg:col-span-5 bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-extrabold text-slate-900 text-base">Category Distribution</h2>
          <p class="text-xs text-slate-400">Products ratio per sportswear category</p>
        </div>
      </div>
      <div class="h-64 flex items-center justify-center">
        <canvas id="categoriesChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Recent Inquiries Table -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
      <h2 class="font-extrabold text-slate-900 text-base">Recent Order Inquiries</h2>
      <a href="/admin/inquiries" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">View All Inquiries &rarr;</a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 text-slate-400 uppercase text-[10px] tracking-wider font-extrabold">
          <tr>
            <th class="py-3 px-6">Customer</th>
            <th class="py-3 px-6">Type</th>
            <th class="py-3 px-6">Status</th>
            <th class="py-3 px-6">Date</th>
          </tr>
        </thead>
          <% 
            const inquiriesList = (typeof recentInquiries !== 'undefined' && recentInquiries) ? recentInquiries : [];
            if (inquiriesList.length > 0) { 
          %>
            <% inquiriesList.forEach(inq => { %>
              <tr class="hover:bg-slate-50/50 transition">
                <td class="py-3.5 px-6 font-semibold text-slate-800">
                  <div><%= inq.name %></div>
                  <div class="text-xs text-slate-400 font-normal"><%= inq.email || inq.phone || 'N/A' %></div>
                </td>
                <td class="py-3.5 px-6">
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase <%= inq.type==='custom' ? 'bg-indigo-50 text-indigo-700' : 'bg-emerald-50 text-emerald-700' %>">
                    <%= inq.type === 'custom' ? '3D Order' : 'Contact' %>
                  </span>
                </td>
                <td class="py-3.5 px-6">
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase bg-amber-50 text-amber-700 border border-amber-200">
                    <%= inq.status || 'Pending' %>
                  </span>
                </td>
                <td class="py-3.5 px-6 text-xs text-slate-400">
                  <%= new Date(inq.createdAt).toLocaleDateString() %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colSpan="4" class="py-8 text-center text-slate-400 text-sm">No recent inquiries recorded yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<!-- Chart.js Library CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // 1. Orders & Inquiries Trend Chart
  const ctxOrders = document.getElementById('ordersChart').getContext('2d');
  new Chart(ctxOrders, {
    type: 'line',
    data: {
      labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
      datasets: [
        {
          label: '3D Custom Kit Orders',
          data: [12, 19, 15, 25, 22, 30, 35],
          borderColor: '#4f46e5',
          backgroundColor: 'rgba(79, 70, 229, 0.1)',
          fill: true,
          tension: 0.4,
          borderWidth: 3
        },
        {
          label: 'General Inquiries',
          data: [8, 12, 10, 18, 15, 20, 24],
          borderColor: '#10b981',
          backgroundColor: 'transparent',
          tension: 0.4,
          borderWidth: 2,
          borderDash: [5, 5]
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'top', labels: { font: { family: 'Plus Jakarta Sans', weight: '600', size: 11 } } }
      },
      scales: {
        x: { grid: { display: false } },
        y: { grid: { color: '#f1f5f9' }, beginAtZero: true }
      }
    }
  });

  // 2. Category Distribution Doughnut Chart
  const ctxCat = document.getElementById('categoriesChart').getContext('2d');
  new Chart(ctxCat, {
    type: 'doughnut',
    data: {
      labels: ['Football', 'Cricket', 'Basketball', 'Wrestling', 'Others'],
      datasets: [{
        data: [35, 25, 20, 12, 8],
        backgroundColor: ['#4f46e5', '#10b981', '#f59e0b', '#ec4899', '#64748b'],
        borderWidth: 0
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'right', labels: { font: { family: 'Plus Jakarta Sans', weight: '600', size: 11 } } }
      },
      cutout: '70%'
    }
  });
</script>

<%- include('partials/footer') %>
