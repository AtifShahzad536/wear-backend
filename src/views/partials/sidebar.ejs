<%
  const page = typeof activePage !== 'undefined' ? activePage : '';
  const navItems = [
    { key: 'dashboard', label: 'Dashboard', url: '/admin', icon: 'bi-grid-1x2-fill' },
    { key: 'categories', label: 'Categories', url: '/admin/categories', icon: 'bi-folder-fill' },
    { key: 'products', label: 'All Products', url: '/admin/products', icon: 'bi-box-seam-fill' },
    { key: 'inquiries', label: 'Orders & Inquiries', url: '/admin/inquiries', icon: 'bi-chat-square-quote-fill' },
    { key: 'models', label: '3D Builder Models', url: '/admin/builder-models', icon: 'bi-bounding-box-circles' },
    { key: 'patterns', label: '3D Patterns', url: '/admin/builder-patterns', icon: 'bi-grid-3x3-gap-fill' },
    { key: 'logos', label: '3D Logos', url: '/admin/builder-logos', icon: 'bi-badge-ad-fill' },
    { key: 'home-videos', label: 'Home Videos', url: '/admin/home-videos', icon: 'bi-film' },
    { key: 'blogs', label: 'Blogs Manager', url: '/admin/blogs', icon: 'bi-journal-text' },
    { key: 'settings', label: 'Global Settings', url: '/admin/settings', icon: 'bi-gear-fill' },
    { key: 'uploads', label: 'Uploads Library', url: '/admin/uploads', icon: 'bi-images' },
  ];
%>

<aside class="col-span-12 md:col-span-3 lg:col-span-2">
  <div class="bg-white border border-slate-200/80 rounded-2xl p-3 sticky top-24 shadow-sm space-y-1">
    <div class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider px-3 mb-2">Main Menu</div>
    <nav class="flex flex-col gap-1">
      <% navItems.forEach(item => { 
        const isActive = page === item.key;
      %>
        <a href="<%= item.url %>"
           class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-xs transition <%= isActive ? 'bg-indigo-600 text-white shadow-sm shadow-indigo-200' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
          <i class="bi <%= item.icon %> text-sm"></i>
          <span><%= item.label %></span>
        </a>
      <% }) %>
    </nav>
  </div>
</aside>
