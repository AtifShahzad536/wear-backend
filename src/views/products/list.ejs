<%- include('../partials/header', { title: 'Category Products' }) %>
<%- include('../partials/sidebar', { activePage: 'categories' }) %>

<main class="col-span-12 md:col-span-9 lg:col-span-10 space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200/80 pb-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-400 font-bold mb-1">
        <a href="/admin/categories" class="hover:underline">Categories</a> &rarr; <span><%= category.name %></span>
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900"><%= category.name %> Products</h1>
    </div>
    <a href="/admin/categories/<%= category.slug %>/products/new" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-sm transition">
      <i class="bi bi-plus-lg"></i> Add Product
    </a>
  </div>

  <!-- Products Grid -->
  <% if ((products||[]).length > 0) { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
      <% products.forEach(p => { %>
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden flex flex-col justify-between group">
          <div>
            <div class="h-44 bg-slate-50 relative overflow-hidden flex items-center justify-center border-b border-slate-100">
              <% if (p.image) { %>
                <img src="<%= p.image %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
              <% } else { %>
                <span class="text-slate-300 text-xs font-bold">No Image</span>
              <% } %>
              <span class="absolute top-2 left-2 bg-slate-900/80 backdrop-blur-md text-white text-[10px] font-mono px-2 py-0.5 rounded-md font-bold">
                <%= p.id %>
              </span>
            </div>
            <div class="p-4 space-y-1">
              <h3 class="font-bold text-slate-900 text-base group-hover:text-indigo-600 transition"><%= p.name %></h3>
              <p class="text-xs text-slate-500 line-clamp-2"><%= p.description || 'No description' %></p>
            </div>
          </div>
          <div class="p-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
            <a href="/admin/categories/<%= category.slug %>/products/<%= p.id %>/edit" class="text-xs font-bold text-indigo-600 hover:underline">Edit</a>
            <form action="/api/admin/categories/<%= category.slug %>/products/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete product <%= p.name %>?')">
              <button type="submit" class="text-xs font-bold text-rose-600 hover:underline">Delete</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="bg-white rounded-2xl border border-slate-200/80 p-12 text-center space-y-3">
      <i class="bi bi-box-seam text-4xl text-slate-300 block"></i>
      <h3 class="font-bold text-slate-700">No products in this category</h3>
      <p class="text-xs text-slate-400">Click "Add Product" above to create gear items for <%= category.name %>.</p>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
