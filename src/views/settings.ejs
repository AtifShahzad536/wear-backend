<%- include('partials/header') %>
<%- include('partials/sidebar', { activePage: 'settings' }) %>

<main class="col-span-12 md:col-span-9 lg:col-span-10">
  <div class="mb-6 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-black text-slate-800 tracking-tight">Global Settings</h1>
      <p class="text-slate-500 text-sm mt-1">Manage global application features and access</p>
    </div>
  </div>

  <% if (success) { %>
    <div class="bg-emerald-50 text-emerald-700 p-4 rounded-xl mb-6 border border-emerald-100 flex items-center gap-3">
      <i class="bi bi-check-circle-fill"></i>
      <span class="font-medium text-sm">Settings updated successfully!</span>
    </div>
  <% } %>

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 overflow-hidden">
    <div class="p-6">
      <form action="/admin/settings" method="POST" class="space-y-6">
        <!-- Custom Builder Toggle -->
        <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-100">
          <div>
            <h3 class="font-bold text-slate-800 text-sm">3D Custom Builder</h3>
            <p class="text-slate-500 text-xs mt-1">Enable or disable access to the 3D Custom Builder on the frontend website.</p>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="customBuilderEnabled" class="sr-only peer" <%= settings.customBuilderEnabled !== false ? 'checked' : '' %>>
            <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
          </label>
        </div>

        <div class="flex justify-end pt-4 border-t border-slate-100">
          <button type="submit" class="px-5 py-2.5 bg-indigo-600 text-white text-sm font-bold rounded-xl shadow-sm shadow-indigo-200 hover:bg-indigo-700 hover:shadow-indigo-300 transition-all focus:ring-4 focus:ring-indigo-100">
            Save Settings
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
