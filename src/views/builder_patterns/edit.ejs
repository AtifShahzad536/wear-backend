<%- include('../partials/header', { title: 'Edit Pattern' }) %>
<%- include('../partials/sidebar', { activePage: 'patterns' }) %>

<main class="col-span-12 md:col-span-9 lg:col-span-10 space-y-6">
  <div class="flex items-center justify-between border-b border-slate-200/80 pb-4">
    <h1 class="text-2xl font-extrabold text-slate-900">Edit Builder Pattern: <%= pattern.name %></h1>
    <a href="/admin/builder-patterns" class="text-xs font-bold text-slate-600 border border-slate-200 px-3 py-2 rounded-xl hover:bg-slate-100">Cancel</a>
  </div>

  <div class="bg-white border border-slate-200/80 rounded-2xl p-6 max-w-xl shadow-sm">
    <form action="/api/admin/builder-patterns/<%= pattern._id %>" method="POST" class="space-y-5">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Pattern Name</label>
        <input type="text" name="name" required value="<%= pattern.name %>" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Pattern Image Path</label>
        <div class="flex gap-2">
          <input type="text" id="image_path" name="image_path" required value="<%= pattern.image_path %>" class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
          <button type="button" onclick="triggerUpload('image_path')" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition">Upload File</button>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <input type="checkbox" name="status" id="status" value="true" <%= pattern.status ? 'checked' : '' %> class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
        <label for="status" class="text-xs font-bold text-slate-700">Active (visible in Customizer)</label>
      </div>

      <div class="flex justify-end pt-2">
        <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-md transition">Save Changes</button>
      </div>
    </form>
  </div>
</main>

<input type="file" id="hiddenFileInput" class="hidden" accept="image/*" />

<script>
  function triggerUpload(fieldId) {
    const fileInput = document.getElementById('hiddenFileInput');
    fileInput.onchange = async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const formData = new FormData();
      formData.append('file', file);
      try {
        const res = await fetch('/api/admin/upload', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed');
        document.getElementById(fieldId).value = data.url;
        showToast('Pattern updated successfully!');
      } catch (err) {
        alert(err.message || 'File upload failed');
      }
    };
    fileInput.click();
  }
</script>

<%- include('../partials/footer') %>
